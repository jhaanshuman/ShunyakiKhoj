RewriteEngine On
RewriteBase /

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Route /panchang directly to /panchang/index.html
RewriteRule ^panchang/?$ panchang/index.html [QSA,L]
RewriteRule ^panchang/daily/?$ panchang/index.html [QSA,L]

# Route /panchang/monthly to /panchang/monthly/index.html
RewriteRule ^panchang/monthly/?$ panchang/monthly/index.html [QSA,L]
RewriteRule ^maasik/?$ panchang/monthly/index.html [QSA,L]

# Route /kundli & /kundli/generate directly to /kundli/index.html
RewriteRule ^kundli/?$ kundli/index.html [QSA,L]
RewriteRule ^kundli/generate/?$ kundli/index.html [QSA,L]

# Route /phaldeepika to /phaldeepika/index.html
RewriteRule ^phaldeepika/?$ phaldeepika/index.html [QSA,L]

# Route /wisdom to /wisdom/index.html
RewriteRule ^wisdom/?$ wisdom/index.html [QSA,L]

# Route /astrology/personal to /landing.html
RewriteRule ^astrology/personal/?$ landing.html [QSA,L]
